{
    "name": "authservice",
    "version": "1.0.0",
    "description": "auth servce",
    "main": "index.js",
    "scripts": {
        "test": "cross-env NODE_ENV=test jest --runInBand --dns-result-order=ipv4first",
        "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand --collectCoverageFrom=\"src/**/*.ts\" --coveragePathIgnorePatterns=\"src/migrations/.*|src/tests/.*|src/__tests__/.*|src/.*\\.test\\.ts|src/.*\\.spec\\.ts\"",
        "dev": "cross-env NODE_ENV=development nodemon src/server.ts",
        "format:fix": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:fix": "eslint . --fix",
        "lint:check": "eslint .",
        "build": "tsc --skipLibCheck",
        "prepare": "husky",
        "start": "ts-node src/index.ts",
        "migration:generate": "typeorm-ts-node-esm migration:generate",
        "migration:create": "typeorm-ts-node-esm migration:create",
        "migration:run": "typeorm-ts-node-esm migration:run ",
        "migration:revert": "typeorm-ts-node-esm migration:revert"
    },
    "author": "Ansh Shah",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^9.14.0",
        "@types/cors": "^2.8.17",
        "@types/eslint__js": "^8.42.3",
        "@types/express": "^5.0.0",
        "@types/http-errors": "^2.0.4",
        "@types/jest": "^29.5.14",
        "@types/node": "^16.11.10",
        "@types/supertest": "^2.0.0",
        "@types/winston": "^2.4.4",
        "cross-env": "^7.0.3",
        "eslint": "^9.14.0",
        "husky": "^9.1.6",
        "jwks-rsa": "^3.1.0",
        "lint-staged": "^15.2.10",
        "mock-jwks": "^1.0.10",
        "nodemon": "^3.1.7",
        "prettier": "3.3.3",
        "supertest": "^2.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "10.9.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.13.0"
    },
    "lint-staged": {
        "*.ts": [
            "npm run format:fix",
            "npm run lint:fix"
        ]
    },
    "dependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.8",
        "@types/dotenv": "^6.1.1",
        "@types/express-jwt": "^6.0.4",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/uuid": "^10.0.0",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-jwt": "^8.4.1",
        "express-validator": "^7.2.0",
        "http-errors": "^2.0.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.4.0",
        "reflect-metadata": "^0.1.13",
        "rsa-pem-to-jwk": "^1.1.3",
        "typeorm": "0.3.20",
        "uuid": "^11.1.0",
        "winston": "^3.16.0",
        "yup": "^1.4.0"
    }
}
